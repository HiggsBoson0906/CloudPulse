# CloudPulse Frontend Environment Configuration
# ===============================================

# Backend API Base URL
# For local development with the Vite dev server proxy: leave blank (defaults to relative path '').
# For production deployments on Vercel connecting to a separately hosted backend:
# Set this to the public URL of your backend API service (without trailing slash).
# Example: https://api.yourdomain.com
VITE_API_BASE_URL=

# Security Notice:
# All VITE_* environment variables are embedded directly into the public client-side bundle.
# NEVER place secret credentials, database passwords, or privileged admin keys in VITE_* variables.
# In production, authentication is performed via runtime credentials entered in the UI or via a secure BFF proxy.
# VITE_API_KEY=

