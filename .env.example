# CloudPulse API & Environment Configuration
PORT=3000
NODE_ENV=development
SERVICE_NAME=cloudpulse

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cloudpulse
POSTGRES_PORT=5432

# Database connection URL for API (for Docker Compose internal networking)
# api container connects to host 'postgres'
DATABASE_URL=postgres://postgres:postgres@postgres:5432/cloudpulse
