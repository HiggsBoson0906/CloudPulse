# ==========================================
# CloudPulse Configuration
# ==========================================

# Application Environment
PORT=3000
NODE_ENV=development
SERVICE_NAME=cloudpulse

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cloudpulse
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cloudpulse

# Redis Cache & Rate Limiting Configuration
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Apache Kafka Event Streaming Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=cloudpulse
KAFKA_GROUP_ID=cloudpulse-event-processor
KAFKA_HEALTH_TOPIC=cloudpulse.health-checks.v1
KAFKA_DLQ_TOPIC=cloudpulse.health-checks.dlq

# Monitoring Worker Configuration
WORKER_CHECK_INTERVAL_MS=5000
WORKER_CONCURRENCY=10
DEFAULT_TIMEOUT_MS=5000

# Security & SSRF Protection
# Set to true for local testing with docker bridge or private subnet targets
ALLOW_PRIVATE_TARGETS=false

# Authentication & Role-Based Access Control (API Keys)
# In production, generate strong, unique, high-entropy secrets (minimum 32 characters).
# Example generator: `openssl rand -hex 24`
# WARNING: Known default/sample keys are rejected by the production config validator.
CLOUDPULSE_ADMIN_API_KEY=fd633bd0cbab191ccf23150524815be1a747a61f110895ff
CLOUDPULSE_OPERATOR_API_KEY=84c9569f658e0a4e1990e8cde0b26c0ab5adfdc3396b3259
CLOUDPULSE_VIEWER_API_KEY=50affc8430ca888865af484ad72dcfb8d721364cbfe120dc

